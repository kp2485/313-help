<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up and nothing is transferred to a new device. The only thing on the phone worth naming is
     the random install secret behind the daily report hash, and it must never be copied anywhere (docs/08). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
