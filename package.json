{
  "name": "detroithelp",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:bundle": "pnpm --filter @detroithelp/pipeline build:bundle",
    "build:bundle:release": "pnpm --filter @detroithelp/pipeline build:bundle -- --release",
    "ingest:opendata": "pnpm --filter @detroithelp/pipeline ingest:opendata && pnpm --filter @detroithelp/pipeline ingest:greenway && pnpm --filter @detroithelp/pipeline ingest:city",
    "geocode": "pnpm --filter @detroithelp/pipeline geocode",
    "keys:generate": "pnpm --filter @detroithelp/pipeline keys:generate",
    "ingest:neighborhoods": "pnpm --filter @detroithelp/pipeline ingest:neighborhoods",
    "ingest:basemap": "pnpm --filter @detroithelp/pipeline ingest:basemap",
    "check:emergency": "pnpm --filter @detroithelp/pipeline check:emergency",
    "check:sources": "pnpm --filter @detroithelp/pipeline check:sources",
    "alert:new": "pnpm --filter @detroithelp/pipeline alert:new",
    "import:lines": "pnpm --filter @detroithelp/pipeline import:lines"
  }
}
