{
  "name": "313-help",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build:bundle": "pnpm --filter @313help/pipeline build:bundle",
    "build:bundle:release": "pnpm --filter @313help/pipeline build:bundle -- --release",
    "ingest:opendata": "pnpm --filter @313help/pipeline ingest:opendata && pnpm --filter @313help/pipeline ingest:mymap && pnpm --filter @313help/pipeline ingest:greenway && pnpm --filter @313help/pipeline ingest:city",
    "ingest:mymap": "pnpm --filter @313help/pipeline ingest:mymap",
    "geocode": "pnpm --filter @313help/pipeline geocode",
    "keys:generate": "pnpm --filter @313help/pipeline keys:generate",
    "ingest:neighborhoods": "pnpm --filter @313help/pipeline ingest:neighborhoods",
    "ingest:basemap": "pnpm --filter @313help/pipeline ingest:basemap",
    "ingest:transit": "pnpm --filter @313help/pipeline ingest:transit",
    "ingest:crashes": "pnpm --filter @313help/pipeline ingest:crashes",
    "check:emergency": "pnpm --filter @313help/pipeline check:emergency",
    "check:sources": "pnpm --filter @313help/pipeline check:sources",
    "tasks:sync": "pnpm --filter @313help/pipeline tasks:sync",
    "preflight": "pnpm --filter @313help/pipeline preflight",
    "smoke": "pnpm --filter @313help/pipeline smoke",
    "alert:new": "pnpm --filter @313help/pipeline alert:new",
    "import:lines": "pnpm --filter @313help/pipeline import:lines",
    "ingest:treatment": "pnpm --filter @313help/pipeline ingest:treatment"
  }
}
