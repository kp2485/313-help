{
  "description": "How old the phone's copy of the list is, and the broken-clock guard. No heartbeat and no automatic shutdown: only a person retires the directory.",
  "cases": [
    {
      "name": "one day old",
      "fn": "bundleAge",
      "now": "2026-09-19T08:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "fresh"
    },
    {
      "name": "four days old",
      "fn": "bundleAge",
      "now": "2026-09-22T09:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "aging"
    },
    {
      "name": "31 days old",
      "fn": "bundleAge",
      "now": "2026-10-19T09:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "old"
    },
    {
      "name": "121 days old: still just an old copy, never shut down by a timer",
      "fn": "bundleAge",
      "now": "2027-01-17T09:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "old"
    },
    {
      "name": "a steward published a final list marked retired",
      "fn": "bundleAge",
      "now": "2026-09-19T12:00:00Z",
      "index": {
        "generated_at": "2026-09-19T08:00Z",
        "retired": true
      },
      "expect": "retired"
    },
    {
      "name": "device clock reset to 2010: use the bundle's build time",
      "fn": "effectiveNow",
      "now": "2010-01-01T00:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "2026-09-18T08:00:00.000Z"
    },
    {
      "name": "sane device clock is kept",
      "fn": "effectiveNow",
      "now": "2026-09-20T00:00:00Z",
      "index": {
        "generated_at": "2026-09-18T08:00:00Z"
      },
      "expect": "2026-09-20T00:00:00.000Z"
    },
    {
      "name": "an unreadable build date is never shown as fresh",
      "fn": "bundleAge",
      "now": "2026-09-19T12:00:00Z",
      "index": {
        "generated_at": "not a date"
      },
      "expect": "old"
    }
  ]
}
