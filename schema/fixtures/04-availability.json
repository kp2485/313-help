          "freq": "WEEKLY",
          "byday": "MO",
          "dtstart": "2026-09-07",
          "opens_at": "20:00",
          "closes_at": "24:00"
        }
      ]
    },
    {
      "id": "sal_freq_proto",
      "schedules": [
        {
