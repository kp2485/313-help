  "cases": [
    {
      "name": "24/7 line",
      "fn": "openNow",
      "row": "sal_247",
      "now": "2026-09-18T07:00:00Z",
      "expect": {
        "state": "open"
      }
    },
    {
      "name": "call first",
      "fn": "openNow",
      "row": "sal_call",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "call_first"
      }
    },
    {
      "name": "unknown hours",
      "fn": "openNow",
      "row": "sal_unknown",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "scheduled with no schedule rows is unknown, not open",
      "fn": "openNow",
      "row": "sal_sched_empty",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "suspended row is not listed even inside its window",
      "fn": "openNow",
      "row": "sal_suspended",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "not_listed"
      }
    },
    {
      "name": "archived row is not listed",
      "fn": "openNow",
      "row": "sal_archived",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "not_listed"
      }
    },
    {
      "name": "archived row has no upcoming times",
      "fn": "nextOccurrences",
      "row": "sal_archived",
      "now": "2026-09-18T12:00:00Z",
