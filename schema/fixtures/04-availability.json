  "cases": [
    {
      "name": "24/7 line",
      "fn": "openNow",
      "row": "sal_247",
      "now": "2026-09-18T07:00:00Z",
      "expect": {
        "state": "open"
      }
    },
    {
      "name": "call first",
      "fn": "openNow",
      "row": "sal_call",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "call_first"
      }
    },
    {
      "name": "unknown hours",
      "fn": "openNow",
      "row": "sal_unknown",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "scheduled with no schedule rows is unknown, not open",
      "fn": "openNow",
      "row": "sal_sched_empty",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "suspended row is not listed even inside its window",
      "fn": "openNow",
      "row": "sal_suspended",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "not_listed"
      }
    },
    {
      "name": "archived row is not listed",
      "fn": "openNow",
      "row": "sal_archived",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "not_listed"
      }
    },
    {
      "name": "archived row has no upcoming times",
      "fn": "nextOccurrences",
      "row": "sal_archived",
      "now": "2026-09-18T12:00:00Z",
      "expect": []
    },
    {
      "name": "a schedule that cannot be read is never shown as open: interval 0",
      "fn": "openNow",
      "row": "sal_bad_interval",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "\"2nd Tuesday\" on a weekly rule is not a real rule: unknown, not every Tuesday",
      "fn": "openNow",
      "row": "sal_weekly_nth",
      "now": "2026-09-22T15:00:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "a day of the month that is not a number: unknown",
      "fn": "openNow",
      "row": "sal_bad_monthday",
      "now": "2026-10-01T15:00:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "a time that is not HH:MM: unknown",
      "fn": "openNow",
      "row": "sal_bad_time",
      "now": "2026-09-21T22:30:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "one bad schedule does not hide a good one",
      "fn": "openNow",
      "row": "sal_one_good_one_bad",
      "now": "2026-09-18T17:45:00Z",
      "expect": {
        "state": "open",
        "closes_at": "14:30"
      }
    },
    {
      "name": "BYDAY on a daily rule is not a shape the spec defines: unknown",
      "fn": "openNow",
      "row": "sal_daily_byday",
      "now": "2026-09-21T15:00:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "a start date that does not exist (Feb 30): unknown",
      "fn": "openNow",
      "row": "sal_no_such_day",
      "now": "2026-09-21T15:00:00Z",
      "expect": {
        "state": "unknown"
      }
    },
    {
      "name": "24:00 is the end of the day and is allowed",
      "fn": "openNow",
      "row": "sal_midnight_end",
      "now": "2026-09-22T02:00:00Z",
      "expect": {
        "state": "open",
        "closes_at": "24:00"
      }
    },
    {
      "name": "a FREQ that is not one of the four (even a JS built-in name): unknown",
      "fn": "openNow",
      "row": "sal_freq_proto",
      "now": "2026-09-07T15:00:00Z",
      "expect": {
        "state": "unknown"
      }
    }
  ]
}
