  "cases": [
    {
      "name": "visitor confirmed 4 days ago",
      "fn": "badge",
      "row": "sal_confirmed",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "confirmed",
        "key": "badge.confirmed.community_confirm",
        "params": {
          "days": 4
        },
        "tier": 0
      }
    },
    {
      "name": "checked at entry: states the date it was checked",
      "fn": "badge",
      "row": "sal_entry",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "entry_checked",
        "key": "badge.entry_checked.web",
        "params": {
          "date": "2026-09-18"
        }
      }
    },
    {
      "name": "same row two months later: the same dated fact, no \"call first\" just because time passed",
      "fn": "badge",
      "row": "sal_entry",
      "now": "2026-11-15T16:00:00Z",
      "expect": {
        "level": "entry_checked",
        "key": "badge.entry_checked.web",
        "params": {
          "date": "2026-09-18"
        }
      }
    },
    {
      "name": "listed in a 2016 data layer and never checked by a person: say whose list and when, nothing more",
      "fn": "badge",
      "row": "sal_never",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "source_listed",
        "params": {
          "source_date": "2016-11-16"
        }
      }
    },
    {
      "name": "one closed report newer than the last confirm",
      "fn": "badge",
      "row": "sal_reported_once",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "reported_once",
        "params": {
          "date": "2026-10-18"
        }
      }
    },
    {
      "name": "two closed reports",
      "fn": "badge",
      "row": "sal_reported_twice",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "reported_closed",
        "params": {
          "count": 2
        },
        "tier": 5
      }
    },
    {
      "name": "a confirm after the report clears the warning",
      "fn": "badge",
      "row": "sal_confirm_after_report",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "confirmed"
      }
    },
    {
      "name": "same-day confirm does not outweigh a closed report",
      "fn": "badge",
      "row": "sal_same_day",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "reported_once"
      }
    },
    {
