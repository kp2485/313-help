  "cases": [
    {
      "name": "visitor confirmed 4 days ago",
      "fn": "badge",
      "row": "sal_confirmed",
      "now": "2026-10-20T16:00:00Z",
      "expect": {
        "level": "confirmed",
        "key": "badge.confirmed.community_confirm",
        "params": {
          "days": 4
        },
        "tier": 0
      }
    },
    {
      "name": "checked at entry, inside window",
      "fn": "badge",
      "row": "sal_entry",
      "now": "2026-10-20T16:00:00Z",
