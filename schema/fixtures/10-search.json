        "d_moses_org"
      ]
    },
    {
      "name": "accents and case are ignored",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "CAFE",
      "expect": [
        "b_cafe"
      ]
    },
    {
      "name": "punctuation is ignored",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "st moses",
      "expect": [
        "a_pantry",
        "d_moses_org"
      ]
    },
    {
      "name": "street name: name match first, then address match",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "oakman",
      "expect": [
        "c_clinic",
        "a_pantry"
      ]
    },
    {
      "name": "ZIP code",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "48210",
      "expect": [
        "b_cafe"
      ]
    },
    {
      "name": "who it is for is searched",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "insurance",
      "expect": [
        "c_clinic"
      ]
    },
    {
      "name": "one letter matches nothing",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "f",
      "expect": []
    },
    {
      "name": "empty text matches nothing",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "  ",
      "expect": []
