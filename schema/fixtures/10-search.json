    },
    {
      "name": "and the dotted form finds it too",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "y.m.c.a.",
      "expect": [
        "h_ymca"
      ]
    },
    {
      "name": "one letter of any script is too short",
