  "cases": [
    {
      "name": "name match beats a match in the description",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "pantry",
      "expect": [
        "a_pantry",
        "c_clinic"
      ]
    },
    {
      "name": "a token may be the start of a word",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "pant",
      "expect": [
        "a_pantry",
        "c_clinic"
      ]
    },
    {
      "name": "but not the middle of one",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "antry",
      "expect": []
    },
    {
      "name": "every token must match",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "food coats",
      "expect": []
    },
    {
      "name": "organization match comes after name match",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "moses",
      "expect": [
        "a_pantry",
        "d_moses_org"
      ]
    },
    {
      "name": "tokens may be spread over name and organization",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "coats church",
      "expect": [
        "d_moses_org"
      ]
    },
    {
      "name": "accents and case are ignored",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "CAFE",
      "expect": [
        "b_cafe"
      ]
    },
    {
      "name": "punctuation is ignored",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "st moses",
      "expect": [
        "a_pantry",
        "d_moses_org"
      ]
    },
    {
      "name": "street name: name match first, then address match",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "oakman",
      "expect": [
        "c_clinic",
        "a_pantry"
      ]
    },
    {
      "name": "ZIP code",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "48210",
      "expect": [
        "b_cafe"
      ]
    },
    {
      "name": "who it is for is searched",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "insurance",
      "expect": [
        "c_clinic"
      ]
    },
    {
      "name": "one letter matches nothing",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "f",
      "expect": []
    },
    {
      "name": "empty text matches nothing",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "  ",
      "expect": []
    },
    {
      "name": "a category filter still applies",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "free",
      "query": {
        "category": "food"
      },
      "expect": [
        "a_pantry",
        "b_cafe",
        "d_moses_org"
      ]
    },
    {
      "name": "an apostrophe joins: marys finds Mary’s",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "marys",
      "expect": [
        "f_marys"
      ]
    },
    {
      "name": "a typed straight apostrophe matches a curly one",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "mary's",
      "expect": [
        "f_marys"
      ]
    },
    {
      "name": "a curly apostrophe in the query works too",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "Mary’s",
      "expect": [
        "f_marys"
      ]
    },
    {
      "name": "St. with a dot still starts a word",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "st. marys soup",
      "expect": [
        "f_marys"
      ]
    },
    {
      "name": "letters that are not a-z are searchable (Arabic)",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "النور",
      "expect": [
        "g_noor"
      ]
    },
    {
      "name": "a hyphen separates words",
      "fn": "search",
      "now": "2026-09-18T17:45:00Z",
      "text": "al noor",
      "expect": [
        "g_noor"
      ]
    },
    {
      "name": "dots between single letters join: ymca finds Y.M.C.A.",
